{
    "name": "samjuk/m2-module-tinymce-anchors",
    "description": "Introduce the Anchor plugin into the TinyMCE editor to allow for easy linking to text content.",
    "type": "magento2-module",
    "require": {
        "php": "^8.2",
        "magento/framework": "^103.0.6",
        "magento/module-cms": "^104.0",
        "magento/module-page-builder": "^2.2",
        "magento/module-backend": "^102.0"
    },
    "authors": [
        {
            "email": "sam@samdjames.uk",
            "name": "Sam James",
            "homepage": "https://www.samdjames.uk"
        }
    ],
    "license": "MIT",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "SamJUK\\TinyMCE\\": ""
        }
    },
    "homepage": "https://github.com/SamJUK/m2-module-tinymce-anchors",
    "keywords": [
        "magento2",
        "magento 2",
        "magento2-module",
        "adobe-commerce",
        "extension",
        "tinymce",
        "page-builder",
        "cms",
        "wysiwyg",
        "anchor-links",
        "content-editing",
        "open-source"
    ],
    "repositories": [{
        "name": "mage-os",
        "type": "composer",
        "url": "https://mirror.mage-os.org/"
    }],
    "require-dev": {
        "samjuk/dev-standards": "^1.0",
        "magento/magento-coding-standard": "^41.0",
        "phpunit/phpunit": "^9.5 || ^10.5 || ^12.5",
        "bitexpert/phpstan-magento": "^0.44.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "magento/composer-dependency-version-audit-plugin": false,
            "magento/magento-composer-installer": false,
            "phpstan/extension-installer": true
        }
    }
}
